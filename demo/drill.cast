[0.010, "o", "\u001b[H\u001b[J"]
[0.001, "o", "\u001b[1;36mCost-Capped Claude Code on Amazon Bedrock · Verification Gate drill (live)\u001b[0m\r\n"]
[0.002, "o", "\u001b[2maccount 537997492026 · region us-east-1 · team dev · 2026-06-10 11:27 WIB\u001b[0m\r\n"]
[0.000, "o", "\u001b[2mAWS's own IAM evaluation engine answers: would this call be allowed RIGHT NOW?\u001b[0m\r\n"]
[3.008, "o", "\r\n\u001b[1;36m== 0 · Baseline: dev group carries ONLY the invoke leash\u001b[0m\r\n"]
[1.208, "o", "\u001b[1;33m$ aws iam list-attached-group-policies --group-name ccguard-dev-devs\u001b[0m\r\n"]
[1.933, "o", "[\r\n    \"ccguard-dev-invoke\"\r\n]\r\n"]
[2.567, "o", "\r\n\u001b[1;36m== 1 · Leash (G2): approved Haiku profile is ALLOWED\u001b[0m\r\n"]
[1.208, "o", "\u001b[1;33m$ simulate bedrock:InvokeModel on the approved Haiku inference profile\u001b[0m\r\n"]
[1.911, "o", "{\r\n    \"decision\": \"allowed\",\r\n    \"matched\": [\r\n        \"ccguard-dev-invoke\"\r\n    ]\r\n}\r\n"]
[2.564, "o", "\r\n\u001b[1;36m== 2 · Leash (G2): forbidden Opus 4.8 is DENIED, on BOTH doors\u001b[0m\r\n"]
[1.207, "o", "\u001b[1;33m$ simulate bedrock:InvokeModel on foundation-model/anthropic.claude-opus-4-8\u001b[0m\r\n"]
[1.930, "o", "{\r\n    \"decision\": \"implicitDeny\",\r\n    \"matched\": []\r\n}\r\n"]
[2.073, "o", "\u001b[1;33m$ simulate bedrock:InvokeModelWithResponseStream (the streaming door Claude Code uses)\u001b[0m\r\n"]
[1.918, "o", "{\r\n    \"decision\": \"implicitDeny\",\r\n    \"matched\": []\r\n}\r\n"]
[2.597, "o", "\r\n\u001b[1;36m== 3 · The cutoff is WIRED: budget action applies ccguard-dev-frozen automatically\u001b[0m\r\n"]
[1.209, "o", "\u001b[1;33m$ aws budgets describe-budget-action ... (what fires at 100% actual spend)\u001b[0m\r\n"]
[3.747, "o", "{\r\n    \"trigger\": {\r\n        \"ActionThresholdValue\": 100.0,\r\n        \"ActionThresholdType\": \"PERCENTAGE\"\r\n    },\r\n    \"type\": \"APPLY_IAM_POLICY\",\r\n    \"approval\": \"AUTOMATIC\",\r\n    \"status\": \"STANDBY\",\r\n    \"applies\": {\r\n        \"PolicyArn\": \"arn:aws:iam::537997492026:policy/ccguard-dev-frozen\",\r\n        \"Groups\": [\r\n            \"ccguard-dev-devs\"\r\n        ]\r\n    }\r\n}\r\n"]
[3.070, "o", "\r\n\u001b[1;36m== 4 · FIRE the cutoff (G3): attach the exact policy the budget action applies\u001b[0m\r\n"]
[1.210, "o", "\u001b[1;33m$ aws iam attach-group-policy --group-name ccguard-dev-devs --policy-arn .../ccguard-dev-frozen\u001b[0m\r\n"]
[3.147, "o", "[\r\n    \"ccguard-dev-invoke\",\r\n    \"ccguard-dev-frozen\"\r\n]\r\n"]
[2.071, "o", "\u001b[2mcutoff armed: re-ask AWS, is the APPROVED profile still allowed?\u001b[0m\r\n"]
[0.806, "o", "\u001b[1;33m$ simulate bedrock:InvokeModel on the approved Haiku profile (frozen attached)\u001b[0m\r\n"]
[1.936, "o", "{\r\n    \"decision\": \"explicitDeny\",\r\n    \"matched\": [\r\n        \"ccguard-dev-frozen\"\r\n    ]\r\n}\r\n"]
[2.074, "o", "\u001b[1;33m$ simulate bedrock:InvokeModelWithResponseStream (streaming door, frozen attached)\u001b[0m\r\n"]
[1.917, "o", "{\r\n    \"decision\": \"explicitDeny\",\r\n    \"matched\": [\r\n        \"ccguard-dev-frozen\"\r\n    ]\r\n}\r\n"]
[0.063, "o", "\u001b[1;31mdeny-beats-allow: the approved profile flips to explicitDeny on BOTH doors\u001b[0m\r\n"]
[3.005, "o", "\r\n\u001b[1;36m== 5 · REVERSE the cutoff (G4): detach, access must come back\u001b[0m\r\n"]
[1.209, "o", "\u001b[1;33m$ aws iam detach-group-policy --group-name ccguard-dev-devs --policy-arn .../ccguard-dev-frozen\u001b[0m\r\n"]
[3.167, "o", "[\r\n    \"ccguard-dev-invoke\"\r\n]\r\n"]
[2.070, "o", "\u001b[1;33m$ simulate bedrock:InvokeModel on the approved Haiku profile (after detach)\u001b[0m\r\n"]
[1.960, "o", "{\r\n    \"decision\": \"allowed\",\r\n    \"matched\": [\r\n        \"ccguard-dev-invoke\""]
[0.000, "o", "\r\n    ]\r\n}\r\n"]
[2.572, "o", "\r\n\u001b[1;36m== 6 · Zero residue: group is back to baseline\u001b[0m\r\n"]
[1.209, "o", "\u001b[1;33m$ aws iam list-attached-group-policies --group-name ccguard-dev-devs\u001b[0m\r\n"]
[1.893, "o", "[\r\n    \"ccguard-dev-invoke\"\r\n]\r\n"]
[2.074, "o", "\r\n\u001b[1;32mVERDICT: cutoff fires (explicitDeny on both invoke doors) and reverses (allowed again).\u001b[0m\r\n"]
